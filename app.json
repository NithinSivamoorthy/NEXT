{
  "expo": {
    "name": "NEXT",
    "slug": "next",
    "scheme": "next",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", ["expo-image-picker", {"photosPermission": "Allow NEXT to save a photo you choose with a completed NEXT on this device.", "cameraPermission": false, "microphonePermission": false}]],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
